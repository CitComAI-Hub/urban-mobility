# CitCom data space job: one simulation of the last hour (src/dataspace_job.py).
# SUMO from its official Python wheel (eclipse-sumo), not a third-party image.
FROM python:3.12-slim

# git for pip; the rest are shared libraries the SUMO binaries of the wheel link to
RUN apt-get update && apt-get install -y --no-install-recommends git \
        libx11-6 libxext6 libxrender1 libgl1 libexpat1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-job.txt .
RUN pip install --no-cache-dir -r requirements-job.txt \
    && apt-get purge -y git && apt-get autoremove -y

# SUMO_HOME = the wheel's directory (tools/ for randomTrips, routeSampler...)
RUN ln -s "$(python -c 'import sumo, os; print(os.path.dirname(sumo.__file__))')" /opt/sumo
ENV SUMO_HOME=/opt/sumo \
    SUMO_WORK_DIR=/tmp/sumo \
    NETWORK_FILE=/app/data/valencia/valencia.net.xml.gz \
    CANDIDATE_ROUTES_FILE=/app/data/valencia/candidate.rou.xml.gz \
    PYTHONUNBUFFERED=1

COPY src ./src
COPY data ./data

RUN useradd --uid 10001 --no-create-home job
USER 10001
WORKDIR /app/src
CMD ["python", "dataspace_job.py"]
